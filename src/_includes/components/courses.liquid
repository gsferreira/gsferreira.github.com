<!-- Courses Section -->
<section id="courses" class="bg-offwhite py-20 dark:bg-black" aria-labelledby="courses-heading">
  <div class="max-w-3xl mx-auto text-center mb-12">
    <h2 id="courses-heading" class="text-h3 lg:text-h2 mb-4 dark:text-white">Courses</h2>
    <p class="text-lg text-charcoal-80 dark:text-charcoal-20">Level up your coding, design, and leadership skills with these hands-on, real-world learning experiences.</p>
  </div>
  <div class="max-w-5xl mx-auto grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {% assign highlighted_courses = collections.courses | where: "data.highlight", true | sort: "data.date" | reverse %}
    {% for course in highlighted_courses limit:3 %}
      <article class="bg-white rounded-2xl p-8 shadow hover:shadow-md transition flex flex-col items-start border border-charcoal-20 dark:bg-charcoal-80 dark:border-charcoal-80">
        <div class="flex items-baseline justify-between w-full mb-2">
          <span class="text-xs text-charcoal-80 uppercase dark:text-charcoal-20">{{ course.data.level }}</span>
          {% if course.data.featured %}
            <span class="bg-black text-white dark:bg-white dark:text-black px-2 py-1 rounded-full text-xs" aria-label="Featured course">Featured</span>
          {% endif %}
        </div>
        <h3 class="text-card mb-2 dark:text-white">{{ course.data.title }}</h3>
        <p class="text-charcoal-80 mb-4 dark:text-charcoal-20">{{ course.data.description }}</p>
        <div class="flex items-center gap-2 text-xs text-charcoal-80 mb-6 dark:text-charcoal-20">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{{ course.data.duration }}</span>
          <span class="mx-2" aria-hidden="true">•</span>
          <span>{{ course.data.category }}</span>
        </div>
        {% if course.data.rating %}
        <div class="flex items-center gap-1 mb-6" role="img" aria-label="Rating: {{ course.data.rating }} out of 5 stars">
          {% for i in (1..5) %}
            <svg class="w-4 h-4 {% if i <= course.data.rating %}text-charcoal dark:text-white{% else %}text-charcoal-20 dark:text-charcoal-80{% endif %}" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {% endfor %}
          <span class="text-sm ml-1" aria-hidden="true">{{ course.data.rating }}</span>
          <span class="text-sm text-charcoal-80 dark:text-charcoal-20" aria-hidden="true">({{ course.data.reviewCount }})</span>
        </div>
        {% endif %}
        <a href="{{ course.url }}" class="mt-auto inline-block w-full px-0 py-3 bg-black text-white rounded-full font-semibold text-center shadow hover:bg-charcoal-80 dark:bg-white dark:text-black dark:hover:bg-offwhite transition">Learn more about the Course</a>
      </article>
    {% endfor %}
  </div>
  <div class="text-center mt-12">
    <a href="/courses" class="inline-flex items-center px-6 py-3 text-sm font-semibold text-charcoal-80 bg-white border border-charcoal-20 rounded-full hover:bg-white dark:bg-charcoal-80 dark:border-charcoal-80 dark:text-white dark:hover:bg-charcoal-60 transition">
      View All Courses
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 ml-2" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>
</section> 