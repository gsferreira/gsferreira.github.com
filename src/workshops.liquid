---
layout: default.liquid
title: Workshops with Gui Ferreira
description: Where to catch me running a workshop in public, and how to book one for your team. The workshops themselves run through Black Lab Studios.
---

<main class="min-h-screen bg-white dark:bg-black">
    <section class="relative bg-white dark:bg-black py-24 lg:py-32 mt-16 transition-colors">
        <div class="mx-auto w-full max-w-6xl px-6 lg:px-16">
            <div class="text-center space-y-8">
                <h1 class="text-h2 lg:text-h1 text-charcoal dark:text-white transition-colors">Workshops</h1>
                <p class="text-xl lg:text-2xl text-charcoal-80 dark:text-charcoal-20 leading-relaxed max-w-2xl mx-auto transition-colors">I run these through <a href="https://blacklabstudios.com/workshops/" class="underline decoration-1 underline-offset-2 decoration-charcoal-60 dark:decoration-charcoal-40 hover:decoration-current transition-colors">Black Lab Studios</a>. This page is the calendar. If you want one run for your team, the studio takes it from there.</p>
            </div>
        </div>
    </section>

    <section id="upcoming" class="border-t border-charcoal-20 dark:border-charcoal-80 py-24 lg:py-32 dark:bg-black transition-colors">
        <div class="mx-auto w-full max-w-6xl px-6 lg:px-16">
            <div class="space-y-16">
                <div class="text-center space-y-6">
                    <h2 class="text-h3 lg:text-h2 text-charcoal dark:text-white transition-colors">Upcoming sessions</h2>
                    <p class="text-xl text-charcoal-80 dark:text-charcoal-20 max-w-2xl mx-auto transition-colors">Public sessions are run by the conference hosting them. Registration goes through the event.</p>
                </div>

                {% assign hasUpcomingSessions = false %}
                {% for workshop in workshopDates %}
                    {% if workshop.sessions.size > 0 %}
                        {% assign hasUpcomingSessions = true %}
                        {% include 'components/upcoming-sessions.njk', sessions: workshop.sessions, workshopTitle: workshop.title, workshopFormat: workshop.format %}
                    {% endif %}
                {% endfor %}

                {% if hasUpcomingSessions == false %}
                <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-card p-8 lg:p-10 text-center space-y-6">
                    <div class="flex justify-center mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-clock h-12 w-12 text-charcoal-60 dark:text-charcoal-60">
                            <path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"></path>
                            <path d="M16 2v4"></path>
                            <path d="M8 2v4"></path>
                            <path d="M3 10h5"></path>
                            <path d="M17.5 17.5 16 16.25V14"></path>
                            <path d="M22 16a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z"></path>
                        </svg>
                    </div>
                    <h3 class="text-h3 text-charcoal dark:text-white transition-colors">Nothing on the public calendar</h3>
                    <p class="text-charcoal-80 dark:text-charcoal-20 max-w-2xl mx-auto transition-colors">No public dates are booked right now. Private sessions run all year, and Black Lab Studios handles those.</p>
                    <div class="flex justify-center">
                        <a href="https://blacklabstudios.com/workshops/#enquiry" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 bg-black dark:bg-white hover:bg-charcoal-80 dark:hover:bg-charcoal-10 text-white dark:text-black rounded-full px-8 py-3 font-semibold transition-colors">Talk to Black Lab Studios</a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="border-t border-charcoal-20 dark:border-charcoal-80 py-24 lg:py-32 bg-white dark:bg-black transition-colors">
        <div class="mx-auto w-full max-w-6xl px-6 lg:px-16">
            <div class="space-y-16">
                <div class="text-center space-y-6">
                    <h2 class="text-h3 lg:text-h2 text-charcoal dark:text-white transition-colors">What I run</h2>
                    <p class="text-xl text-charcoal-80 dark:text-charcoal-20 max-w-2xl mx-auto transition-colors">Full outlines, formats and booking live at Black Lab Studios.</p>
                </div>

                <div class="grid gap-6">
                    {% for workshop in workshopDates %}
                    <article class="bg-white border border-charcoal-20 dark:bg-charcoal-80 dark:border-charcoal-80 rounded-card p-6 lg:p-8 hover:shadow-md dark:hover:ring-1 dark:hover:ring-charcoal-20 transition-shadow duration-300">
                        <div class="flex flex-col lg:flex-row lg:items-center gap-4 lg:gap-8">
                            <div class="flex-1 space-y-2">
                                <div class="flex items-center gap-3 text-sm">
                                    <span class="bg-black dark:bg-white text-white dark:text-black px-3 py-1 rounded-full font-semibold transition-colors">{{ workshop.format }}</span>
                                </div>
                                <h3 class="text-card lg:text-h3 text-charcoal dark:text-white transition-colors">{{ workshop.title }}</h3>
                                <p class="text-charcoal-80 dark:text-charcoal-20 transition-colors">{{ workshop.blurb }}</p>
                            </div>
                            <div class="lg:justify-end">
                                <a href="{{ workshop.blsUrl }}" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border h-10 border-charcoal-20 dark:border-charcoal-20 text-charcoal dark:text-white hover:bg-charcoal-5 dark:hover:bg-charcoal-60 rounded-full px-6 py-2 font-semibold transition-colors">
                                    See the full outline
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-4 w-4" aria-hidden="true">
                                        <path d="M7 7h10v10"></path>
                                        <path d="M7 17 17 7"></path>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <section class="border-t border-charcoal-20 dark:border-charcoal-80 py-24 lg:py-32 dark:bg-black transition-colors">
        <div class="mx-auto w-full max-w-6xl px-6 lg:px-16">
            <div class="max-w-2xl mx-auto text-center space-y-8">
                <h2 class="text-h3 lg:text-h2 text-charcoal dark:text-white transition-colors">Run one for your team</h2>
                <p class="text-xl text-charcoal-80 dark:text-charcoal-20 leading-relaxed transition-colors">Private sessions are on-site or remote, tailored to the codebase your team actually works in. Black Lab Studios scopes and books them, and I am the one who shows up.</p>
                <div class="flex justify-center">
                    <a href="https://blacklabstudios.com/workshops/#enquiry" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 bg-black dark:bg-white hover:bg-charcoal-80 dark:hover:bg-charcoal-10 text-white dark:text-black rounded-full px-8 py-3 font-semibold transition-colors">
                        Talk to Black Lab Studios
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right h-4 w-4" aria-hidden="true">
                            <path d="M7 7h10v10"></path>
                            <path d="M7 17 17 7"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>
