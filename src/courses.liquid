---
layout: default
title: Courses by Gui Ferreira
description: Learn to code like an artist. Ship like a pro.
---

<section class="relative bg-offwhite dark:bg-black py-24 lg:py-32 mt-16 transition-colors">
  <div class="mx-auto w-full max-w-6xl px-6 lg:px-16">
    <div class="text-center space-y-8">
      <h1 class="text-h2 lg:text-h1 text-charcoal dark:text-white transition-colors">
      <p class="text-xl lg:text-2xl text-charcoal-80 dark:text-charcoal-20 leading-relaxed max-w-2xl mx-auto transition-colors">{{ description }}</p>
    </div>
  </div>
</section>

<section class="py-12 lg:py-16 bg-offwhite dark:bg-black transition-colors">
  <div class="mx-auto w-full max-w-6xl px-6 lg:px-16">
    <div class="grid gap-12">
      {% for course in collections.courses %}
        {% if course.data.featured %}
          <article class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-card p-8 lg:p-12 transition-colors">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
              <div class="aspect-video relative rounded-2xl overflow-hidden bg-charcoal-20 dark:bg-charcoal-80">
                <img src="{{ course.data.image }}" alt="{{ course.data.title }}" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; inset: 0px; color: transparent;">
                <div class="absolute top-4 left-4">
                  <span class="bg-black dark:bg-white text-white dark:text-black px-3 py-1 rounded-full text-sm font-semibold transition-colors">Featured</span>
                </div>
              </div>
              <div class="space-y-8">
                <div class="space-y-4">
                  <div class="flex items-center gap-4 text-sm">
                    <span class="bg-black dark:bg-white text-white dark:text-black px-3 py-1 rounded-full font-semibold transition-colors">{{ course.data.level }}</span>
                    {% if course.data.rating %}
                    <div class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4 w-4 fill-current text-charcoal dark:text-white">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                      <span class="font-semibold text-charcoal dark:text-white transition-colors">{{ course.data.rating }}</span>
                      <span class="text-charcoal-80 dark:text-charcoal-20 transition-colors">({{ course.data.reviewCount }} reviews)</span>
                    </div>
                    {% endif %}
                  </div>
                  <h2 class="text-h3 text-charcoal dark:text-white transition-colors">{{ course.data.title }}</h2>
                  <p class="text-xl text-charcoal-80 dark:text-charcoal-20 leading-relaxed transition-colors">{{ course.data.description }}</p>
                </div>
                <div class="flex items-center gap-6 text-sm">
                  <div class="flex items-center gap-2 text-charcoal-80 dark:text-charcoal-20 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-4 w-4">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>{{ course.data.duration }}</span>
                  </div>
                  <span class="text-charcoal-80 dark:text-charcoal-20 transition-colors">{{ course.data.category }}</span>
                </div>
                <div class="space-y-4">
                  <ul class="space-y-2">
                    {% for point in course.data.learningPoints %}
                      <li class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big h-5 w-5 text-charcoal-60 dark:text-charcoal-60 mt-0.5 flex-shrink-0">
                          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                          <path d="m9 11 3 3L22 4"></path>
                        </svg>
                        <span class="text-charcoal-80 dark:text-charcoal-20 transition-colors">{{ point }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
                <div class="flex gap-4">
                  <a href="{{ course.url }}" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 bg-black dark:bg-white hover:bg-charcoal-80 dark:hover:bg-offwhite text-white dark:text-black rounded-full px-8 py-3 font-semibold transition-colors">Learn more about the Course</a>
                </div>
              </div>
            </div>
          </article>
        {% else %}
          <article class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-card p-8 lg:p-10 hover:shadow-md dark:hover:ring-1 dark:hover:ring-charcoal-20 transition-shadow duration-300">
            <div class="grid lg:grid-cols-3 gap-8 items-center">
              <div class="aspect-video relative rounded-2xl overflow-hidden bg-charcoal-20 dark:bg-charcoal-80">
                <img src="{{ course.data.image }}" alt="{{ course.data.title }}" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position: absolute; height: 100%; width: 100%; inset: 0px; color: transparent;">
              </div>
              <div class="lg:col-span-2 space-y-6">
                <div class="space-y-4">
                  <div class="flex items-center gap-4 text-sm">
                    <span class="text-charcoal-80 dark:text-charcoal-20 font-semibold uppercase tracking-wide transition-colors">{{ course.data.level }}</span>
                    {% if course.data.rating %}
                    <div class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4 w-4 fill-current text-charcoal dark:text-white">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                      <span class="font-semibold text-charcoal dark:text-white transition-colors">{{ course.data.rating }}</span>
                      <span class="text-charcoal-80 dark:text-charcoal-20 transition-colors">({{ course.data.reviewCount }})</span>
                    </div>
                    {% endif %}
                  </div>
                  <h2 class="text-h3 text-charcoal dark:text-white transition-colors">{{ course.data.title }}</h2>
                  <p class="text-charcoal-80 dark:text-charcoal-20 leading-relaxed transition-colors">{{ course.data.description }}</p>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-4">
                  <div class="flex items-center gap-6 text-sm text-charcoal-80 dark:text-charcoal-20 transition-colors">
                    <div class="flex items-center gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-4 w-4">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      <span>{{ course.data.duration }}</span>
                    </div>
                    <span>{{ course.data.category }}</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <a href="{{ course.url }}" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 bg-black dark:bg-white hover:bg-charcoal-80 dark:hover:bg-offwhite text-white dark:text-black rounded-full px-6 py-2 font-semibold transition-colors">Learn more about the Course</a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Testimonials Section -->
