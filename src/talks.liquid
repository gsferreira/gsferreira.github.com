---
layout: default
title: Talks by Gui Ferreira
description: Talks I've given. Ideas worth sharing.
---

<div class="mx-auto w-full max-w-6xl px-6 lg:px-16 py-16">
    <h1 class="text-h3 lg:text-h2 text-center mb-4 text-charcoal dark:text-white">Talks</h1>
    <p class="text-center text-charcoal-80 dark:text-charcoal-40 mb-8">{{description}}</p>
    <p class="text-center text-charcoal-80 dark:text-charcoal-40 mb-16">Want me to speak at your event? <a href="mailto:gui@guiferreira.me" class="text-black dark:text-white hover:underline">Get in touch!</a></p>

    {% for talk in talks.all %}
    <div class="mb-24">
        <h2 class="text-h3 mb-4 text-charcoal dark:text-white">{{ talk.title }}</h2>
        <div class="text-charcoal-80 dark:text-charcoal-40 mb-8 whitespace-pre-wrap">{{ talk.description }}</div>

        <div class="mb-4 text-base font-semibold text-charcoal dark:text-white">Presented at</div>
        <div class="space-y-4">
            {% for presentation in talk.presentations %}
            <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 p-6 rounded-card flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 class="text-card text-charcoal dark:text-white">{{ presentation.name }}</h3>
                        <a href="{{ presentation.url }}" target="_blank" rel="noopener" class="text-charcoal-60 hover:text-charcoal-80 dark:hover:text-white">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"/>
                            </svg>
                        </a>
                    </div>
                    <div class="flex items-center gap-1.5 text-charcoal-80 dark:text-charcoal-20">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
                        </svg>
                        <span>{{ presentation.date | readableDate }}</span>
                    </div>
                </div>
                <div>
                    {% if presentation.recording %}
                    <a href="{{ presentation.recording }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-black dark:bg-white text-white dark:text-black px-4 py-2 rounded-full text-sm hover:bg-charcoal-80 dark:hover:bg-charcoal-10 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>
                            
                        </svg>
                        Watch video
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
</div>

{% include "components/newsletter.liquid" %} 