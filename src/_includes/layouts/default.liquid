<!DOCTYPE html>
<html class="overflow-y-scroll font-sans bg-white text-charcoal dark:bg-black dark:text-white" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no, viewport-fit=cover" />
    <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}" />
    <meta name="generator" content="{{ eleventy.generator }}">
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1A1A1A" media="(prefers-color-scheme: dark)">
    <script>
      // Must stay blocking and ahead of the stylesheet to avoid a flash of the
      // light surface for visitors who prefer dark.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    <base href="{{ page.url }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <title>{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}</title>

    {%- assign og_title = title | default: site.title -%}
    {%- assign og_description = description | default: site.description -%}
    <meta property="og:type" content="{% if layout == 'post' %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ og_title }}">
    <meta property="og:description" content="{{ og_description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ page.url | ogImagePath }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ og_title }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@gsferreira">
    <meta name="twitter:creator" content="@gsferreira">
    <meta name="twitter:title" content="{{ og_title }}">
    <meta name="twitter:description" content="{{ og_description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ page.url | ogImagePath }}">

    <link rel="shortcut icon" href="/images/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="manifest" href="/images/site.webmanifest">

    <!-- Preconnect to Google Fonts for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Preload critical hero image - only best format -->
    {% if page.url == "/" %}
    <link rel="preload" as="image" href="/assets/headshot.avif" type="image/avif" fetchpriority="high">
    {% endif %}

    <link rel="stylesheet" href="/styles.css" />
    
    <!-- Load Google Fonts asynchronously to prevent render blocking -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;1,300&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;1,300&display=swap"></noscript>
    <style>
      /* Skip link styles */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: #1A1A1A;
        color: #FFFFFF;
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 9999px;
        z-index: 9999;
        font-family: inherit;
        font-size: 14px;
        line-height: 20px;
        font-weight: 600;
      }
      .skip-link:focus {
        top: 6px;
      }
      /* Improved focus styles */
      :focus-visible {
        outline: 2px solid #1A1A1A;
        outline-offset: 2px;
      }
      .dark :focus-visible {
        outline-color: #FFFFFF;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-black">
    <!-- Skip Navigation Links -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <a href="#navigation" class="skip-link">Skip to navigation</a>
    
    <!-- Navigation -->
    <nav id="navigation" class="w-full border-b border-charcoal-20 bg-white dark:bg-black dark:border-charcoal-80" role="navigation" aria-label="Main navigation">
      <div class="mx-auto w-full max-w-6xl px-6 lg:px-16 flex items-center justify-between py-4">
        <a href="/" class="text-lg font-semibold tracking-tight text-charcoal dark:text-white" aria-label="Gui Ferreira - Home">Gui Ferreira</a>
        
        <!-- Mobile menu button -->
        <button 
          id="mobile-menu-button" 
          class="md:hidden text-charcoal dark:text-white" 
          aria-expanded="false" 
          aria-controls="mobile-menu"
          aria-label="Toggle mobile menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <g class="mobile-menu-icon"><path d="M4 12h16"/><path d="M4 6h16"/><path d="M4 18h16"/></g>
            <g class="mobile-menu-close hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></g>
          </svg>
        </button>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center space-x-8 text-sm ">
          <ul class="flex items-center space-x-8" role="list">
            <li><a href="/about" class="text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition">About</a></li>
            <li><a href="/blog" class="text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition">Blog</a></li>
            <li><a href="/talks" class="text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition">Talks</a></li>
            <li><a href="/courses" class="text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition">Courses</a></li>
            <li><a href="/workshops" class="text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition">Workshops</a></li>
          </ul>
          <!-- Dark mode toggle -->
          <button 
            id="theme-toggle" 
            class="w-10 h-10 p-2 rounded-full hover:bg-charcoal-20 dark:hover:bg-charcoal-60 transition text-charcoal dark:text-white" 
            aria-label="Toggle dark mode"
            type="button"
          >
            <svg class="w-6 h-6 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
            <svg class="w-6 h-6 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
          </button>
          <a href="/newsletter" class="ml-2 px-6 py-2 bg-black text-white rounded-full shadow hover:bg-charcoal-80 dark:bg-white dark:text-black dark:hover:bg-charcoal-10 transition">Join 2k+ Subscribers</a>
        </div>
      </div>

      <!-- Mobile Navigation Menu -->
      <div id="mobile-menu" class="hidden md:hidden" role="menu" aria-labelledby="mobile-menu-button">
        <div class="px-4 py-2 space-y-3">
          <a href="/about" class="block text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition" role="menuitem">About</a>
          <a href="/blog" class="block text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition" role="menuitem">Blog</a>
          <a href="/talks" class="block text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition" role="menuitem">Talks</a>
          <a href="/courses" class="block text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition" role="menuitem">Courses</a>
          <a href="/workshops" class="block text-charcoal dark:text-white hover:text-black/80 dark:hover:text-white/80 transition" role="menuitem">Workshops</a>
          <a href="/newsletter" class="block px-6 py-2 bg-black text-white text-center rounded-full shadow hover:bg-charcoal-80 dark:bg-white dark:text-black dark:hover:bg-charcoal-10 transition" role="menuitem">Join 2k+ Subscribers</a>
        </div>
      </div>
    </nav>
    
    <!-- Main Content -->
    <main id="main-content" role="main">
      {{ content }}
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-charcoal-20 mt-24 dark:bg-black dark:border-charcoal-80" role="contentinfo">
      <div class="mx-auto w-full max-w-6xl px-6 lg:px-16 py-16 grid grid-cols-1 md:grid-cols-4 gap-12 text-sm text-charcoal-80 dark:text-charcoal-20">
        <div>
          <div class="font-semibold mb-2">Gui Ferreira</div>
          <p class="text-charcoal-80 dark:text-charcoal-20">Inspiring developers.</p>
        </div>
        <div>
          <div class="font-semibold mb-2">Learn</div>
          <ul class="space-y-1">
            <li><a href="/courses" class="hover:underline">Courses</a></li>
            <li><a href="/workshops" class="hover:underline">Workshops</a></li>
            <li><a href="/talks" class="hover:underline">Talks</a></li>
          </ul>
        </div>
        <div>
          <div class="font-semibold mb-2">Connect</div>
          <ul class="space-y-1">
            <li><a href="https://www.linkedin.com/in/gferreira" class="hover:underline" aria-label="LinkedIn profile">LinkedIn</a></li>
            <li><a href="https://twitter.com/gsferreira" class="hover:underline" aria-label="Twitter profile">Twitter</a></li>
            <li><a href="https://www.youtube.com/@gui.ferreira" class="hover:underline" aria-label="YouTube channel">YouTube</a></li>
          </ul>
        </div>
        <div>
          <div class="font-semibold mb-2">Contact</div>
          <ul class="space-y-1">
            <li><a href="mailto:gui@guiferreira.me" class="hover:underline">Contact</a></li>
            <li><a href="/feed.xml" class="hover:underline">RSS</a></li>
          </ul>
        </div>
      </div>
      <div class="mx-auto w-full max-w-6xl px-6 lg:px-16 border-t border-charcoal-20 dark:border-charcoal-80 py-6 flex flex-col md:flex-row items-center justify-between text-xs text-charcoal-80 dark:text-charcoal-20">
        <div class="mb-2 md:mb-0">© 2026 Gui Ferreira. All rights reserved.</div>
        <div class="space-x-4">
          <a href="/privacy" class="hover:underline">Privacy</a>
          <a href="/terms" class="hover:underline">Terms</a>
        </div>
      </div>
    </footer>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const utmStorageKey = 'kitNewsletterUtm';
        const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

        function getStoredUtm() {
          try {
            const storedValue = localStorage.getItem(utmStorageKey);
            return storedValue ? JSON.parse(storedValue) : {};
          } catch (error) {
            return {};
          }
        }

        function saveStoredUtm(utmValues) {
          try {
            localStorage.setItem(utmStorageKey, JSON.stringify(utmValues));
          } catch (error) {
            // Ignore storage failures so newsletter submit still works.
          }
        }

        function getUtmValues() {
          const currentParams = new URLSearchParams(window.location.search);
          const currentUtm = {};

          utmKeys.forEach((key) => {
            const value = currentParams.get(key);
            if (value) {
              currentUtm[key] = value;
            }
          });

          const mergedUtm = { ...getStoredUtm(), ...currentUtm };

          if (Object.keys(currentUtm).length > 0) {
            saveStoredUtm(mergedUtm);
          }

          return mergedUtm;
        }

        function applyUtmValuesToForms(utmValues) {
          if (Object.keys(utmValues).length === 0) {
            return;
          }

          document.querySelectorAll('form[data-capture-utm="true"]').forEach((form) => {
            utmKeys.forEach((key) => {
              const value = utmValues[key];
              if (!value) {
                return;
              }

              const input = form.querySelector(`[data-utm-field="${key}"]`);
              if (input) {
                input.value = value;
              }
            });
          });
        }

        applyUtmValuesToForms(getUtmValues());

        // Theme toggle functionality
        const themeToggle = document.getElementById('theme-toggle');
        const root = document.documentElement;
        
        function setTheme(isDark) {
          if (isDark) {
            root.classList.add('dark');
            localStorage.setItem('theme', 'dark');
            themeToggle.setAttribute('aria-label', 'Switch to light mode');
          } else {
            root.classList.remove('dark');
            localStorage.setItem('theme', 'light');
            themeToggle.setAttribute('aria-label', 'Switch to dark mode');
          }
        }

        // Initial state is set by the blocking script in <head>. Only sync the
        // toggle's label here, so localStorage is written on explicit choice only.
        themeToggle.setAttribute('aria-label',
          root.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode');

        // Toggle theme on click
        themeToggle.addEventListener('click', () => {
          const isDark = root.classList.contains('dark');
          setTheme(!isDark);
        });

        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
          if (!localStorage.getItem('theme')) {
            setTheme(e.matches);
          }
        });

        // Mobile menu functionality
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.querySelector('.mobile-menu-icon');
        const closeIcon = document.querySelector('.mobile-menu-close');

        mobileMenuButton.addEventListener('click', () => {
          const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
          const newExpanded = !isExpanded;
          
          mobileMenu.classList.toggle('hidden');
          menuIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
          
          mobileMenuButton.setAttribute('aria-expanded', newExpanded);
          mobileMenuButton.setAttribute('aria-label', newExpanded ? 'Close mobile menu' : 'Open mobile menu');
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
          if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
            if (!mobileMenu.classList.contains('hidden')) {
              mobileMenu.classList.add('hidden');
              menuIcon.classList.remove('hidden');
              closeIcon.classList.add('hidden');
              mobileMenuButton.setAttribute('aria-expanded', 'false');
              mobileMenuButton.setAttribute('aria-label', 'Open mobile menu');
            }
          }
        });

        // Close mobile menu on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
            menuIcon.classList.remove('hidden');
            closeIcon.classList.add('hidden');
            mobileMenuButton.setAttribute('aria-expanded', 'false');
            mobileMenuButton.setAttribute('aria-label', 'Open mobile menu');
            mobileMenuButton.focus();
          }
        });
      });
    </script>
     
    <script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>

  </body>
</html> 
