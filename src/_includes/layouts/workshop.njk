---
layout: default.liquid
---

<section class="relative bg-offwhite dark:bg-black py-24 lg:py-32 mt-16 transition-colors">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <div class="space-y-6">
        <div class="aspect-[4/3] relative rounded-3xl overflow-hidden bg-charcoal-20 dark:bg-charcoal-80">
          <img alt="{{ title }}" decoding="async" data-nimg="fill" class="object-cover" src="{{ image }}" style="position: absolute; height: 100%; width: 100%; inset: 0px; color: transparent;">
          <div class="absolute top-6 left-6">
            <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent hover:bg-primary/80 bg-black dark:bg-white text-white dark:text-black font-medium">{{ category }}</div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-2xl p-4 text-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-6 w-6 mx-auto mb-2 text-charcoal-80 dark:text-charcoal-20">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div class="text-sm font-medium text-charcoal dark:text-white transition-colors">{{ duration }}</div>
            <div class="text-xs text-charcoal-80 dark:text-charcoal-20 transition-colors">Duration</div>
          </div>
          <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-2xl p-4 text-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-6 w-6 mx-auto mb-2 text-charcoal-80 dark:text-charcoal-20">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <div class="text-sm font-medium text-charcoal dark:text-white transition-colors">{{ participants }}</div>
            <div class="text-xs text-charcoal-80 dark:text-charcoal-20 transition-colors">Group Size</div>
          </div>
          <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-2xl p-4 text-center transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-target h-6 w-6 mx-auto mb-2 text-charcoal-80 dark:text-charcoal-20">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
            <div class="text-sm font-medium text-charcoal dark:text-white transition-colors">{{ level }}</div>
            <div class="text-xs text-charcoal-80 dark:text-charcoal-20 transition-colors">Level</div>
          </div>
        </div>
      </div>
      <div class="space-y-8">
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-charcoal dark:text-charcoal-40 border-charcoal-20 dark:border-charcoal-80">{{ format }}</div>
            {% if rating and reviews %}
            <div class="flex items-center gap-1">
              {% for i in range(0, 5) %}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4 w-4 fill-current text-charcoal dark:text-white">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              {% endfor %}
              <span class="text-sm font-medium text-charcoal dark:text-white transition-colors">{{ rating }}</span>
              <span class="text-sm text-charcoal-80 dark:text-charcoal-40 transition-colors">({{ reviews }} reviews)</span>
            </div>
            {% endif %}
          </div>
          <h1 class="text-4xl lg:text-5xl font-medium text-charcoal dark:text-white leading-tight tracking-tight transition-colors">{{ title }}</h1>
          <p class="text-xl text-charcoal-80 dark:text-charcoal-20 font-light leading-relaxed transition-colors">{{ description }}</p>
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-medium text-charcoal dark:text-white transition-colors">What you'll achieve:</h3>
          <ul class="space-y-3">
            {% for achievement in achievements %}
            <li class="flex items-start gap-3">
              <div class="w-2 h-2 bg-black dark:bg-white rounded-full mt-2 flex-shrink-0 transition-colors"></div>
              <span class="text-charcoal-80 dark:text-charcoal-20 font-light transition-colors">{{ achievement }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        <div class="space-y-4">
          <h3 class="text-xl font-medium text-charcoal dark:text-white transition-colors">Prerequisites:</h3>
          <ul class="space-y-2">
            {% for prerequisite in prerequisites %}
            <li class="flex items-start gap-3">
              <div class="w-2 h-2 bg-charcoal-40 dark:bg-charcoal-40 rounded-full mt-2 flex-shrink-0 transition-colors"></div>
              <span class="text-charcoal-80 dark:text-charcoal-20 font-light text-sm transition-colors">{{ prerequisite }}</span>
            </li>
            {% endfor %}
          </ul>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <a href="#upcoming" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-10 bg-black dark:bg-white hover:bg-charcoal-80 dark:hover:bg-offwhite text-white dark:text-black rounded-full px-8 py-3 font-medium transition-colors">View Upcoming Sessions</a>
          <a href="mailto:gui@guiferreira.me" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border bg-background hover:text-accent-foreground h-10 border-charcoal-20 dark:border-charcoal-80 text-charcoal dark:text-white hover:bg-white dark:hover:bg-charcoal-60 rounded-full px-8 py-3 font-medium transition-colors">Request Custom Workshop</a>
        </div>
        <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-2xl p-6 transition-colors">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-charcoal-20 dark:bg-charcoal-80 overflow-hidden relative">
              <img alt="Instructor" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" src="{{ instructor.image }}" style="position: absolute; height: 100%; width: 100%; inset: 0px; color: transparent;">
            </div>
            <div>
              <div class="font-medium text-charcoal dark:text-white transition-colors">{{ instructor.name }}</div>
              <div class="text-sm text-charcoal-80 dark:text-charcoal-20 transition-colors">{{ instructor.title }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-12 lg:py-16 bg-offwhite dark:bg-black transition-colors">
  <div class="container mx-auto px-6 max-w-4xl">
    <div class="prose dark:prose-invert dark:text-charcoal-20 prose-headings:dark:text-white prose-strong:dark:text-white prose-ul:dark:text-gray-200 max-w-none">
      {{ content | safe }}
    </div>
  </div>
</section>

<section class="border-t border-charcoal-20 dark:border-charcoal-80 py-12 lg:py-16 dark:bg-black transition-colors">
  <div class="container mx-auto px-6 max-w-4xl">
    <div class="space-y-16">
      <div class="text-center space-y-6">
        <h2 class="text-4xl lg:text-5xl font-light text-charcoal dark:text-white tracking-tight transition-colors">Curriculum</h2>
        <p class="text-xl text-charcoal-80 dark:text-charcoal-20 font-light max-w-2xl mx-auto transition-colors">{{ curriculum.description }}</p>
      </div>
      <div class="space-y-8">
        {% for module in curriculum.modules %}
        <div class="bg-white dark:bg-charcoal-80 rounded-2xl p-8 hover:shadow-md dark:hover:ring-1 dark:hover:ring-charcoal-20 transition-shadow duration-300">
          <div class="flex gap-6">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-black dark:bg-white rounded-full flex items-center justify-center transition-colors">
                <span class="text-white dark:text-black font-medium text-sm transition-colors">{{ loop.index }}</span>
              </div>
            </div>
            <div class="space-y-4 flex-1">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-medium text-charcoal dark:text-white transition-colors">{{ module.title }}</h3>
                <div class="flex items-center gap-2 text-sm text-charcoal-80 dark:text-charcoal-20 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-4 w-4">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{{ module.duration }}</span>
                </div>
              </div>
              <p class="text-charcoal-80 dark:text-charcoal-20 font-light leading-relaxed transition-colors">{{ module.description }}</p>
              <div class="space-y-2">
                <h4 class="font-medium text-charcoal dark:text-white text-sm transition-colors">Key Topics:</h4>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                  {% for topic in module.topics %}
                  <li class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check-big h-4 w-4 text-charcoal-60 dark:text-charcoal-60 flex-shrink-0">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <path d="m9 11 3 3L22 4"></path>
                    </svg>
                    <span class="text-charcoal-80 dark:text-charcoal-20 font-light text-sm transition-colors">{{ topic }}</span>
                  </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>


<section id="upcoming" class="border-t border-charcoal-20 dark:border-charcoal-80 py-24 lg:py-32 dark:bg-black transition-colors">
  <div class="container mx-auto px-6 max-w-4xl">
    <div class="space-y-16">
      <div class="text-center space-y-6">
        <h2 class="text-4xl lg:text-5xl font-light text-charcoal dark:text-white tracking-tight transition-colors">Upcoming Sessions</h2>
        <p class="text-xl text-charcoal-80 dark:text-charcoal-20 font-light max-w-2xl mx-auto transition-colors">Join our next available sessions. Limited seats available.</p>
      </div>

      {% set sessions = upcomingSessions %}
      {% set workshopTitle = title %}
      {% set workshopFormat = format %}
      {% include "components/upcoming-sessions.njk" %}
    </div>
  </div>
</section>

{% if testimonials %}
<section class="py-12 lg:py-16 bg-offwhite dark:bg-black transition-colors">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="space-y-16">
      <div class="text-center space-y-6">
        <h2 class="text-4xl lg:text-5xl font-light text-charcoal dark:text-white tracking-tight transition-colors">What participants say</h2>
      </div>
      <div class="grid lg:grid-cols-3 gap-8">
        {% for testimonial in testimonials %}
        <div class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-2xl p-8 space-y-6 transition-colors">
          <div class="flex gap-1">
            {% for i in range(0, 5) %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4 w-4 fill-current text-charcoal dark:text-white">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            {% endfor %}
          </div>
          <blockquote class="text-lg text-charcoal-80 dark:text-charcoal-20 font-light leading-relaxed transition-colors">{{ testimonial.quote }}</blockquote>
          <div class="flex items-center gap-4">
            {% if testimonial.image %}
            <div class="w-10 h-10 rounded-full bg-charcoal-20 dark:bg-charcoal-80 overflow-hidden relative">
              <img alt="{{ testimonial.author }}" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" src="{{ testimonial.image }}" style="position: absolute; height: 100%; width: 100%; inset: 0px; color: transparent;">
            </div>
            {% endif %}
            <div>
              <div class="font-medium text-charcoal dark:text-white transition-colors">{{ testimonial.author }}</div>
              <div class="text-sm text-charcoal-80 dark:text-charcoal-20 transition-colors">{{ testimonial.title }}</div>
              <div class="text-sm text-charcoal-80 dark:text-charcoal-20 font-medium transition-colors">{{ testimonial.company }}</div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% if faqs %}
<section class="border-t border-charcoal-20 dark:border-charcoal-80 py-24 lg:py-32 dark:bg-black transition-colors">
  <div class="container mx-auto px-6 max-w-4xl">
    <div class="space-y-16">
      <div class="text-center space-y-6">
        <h2 class="text-4xl lg:text-5xl font-light text-charcoal dark:text-white tracking-tight transition-colors">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-4" data-orientation="vertical" id="faq-accordion">
        {% for faq in faqs %}
        <div data-state="closed" data-orientation="vertical" class="faq-item border-b bg-white dark:bg-charcoal-80 rounded-2xl px-8 border-none transition-colors">
          <h3 data-orientation="vertical" data-state="closed" class="flex">
            <button type="button" class="faq-button flex flex-1 items-center justify-between text-left font-medium text-charcoal dark:text-white hover:no-underline py-6 transition-colors" aria-expanded="false">
              {{ faq.question }}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down h-4 w-4 shrink-0 transition-transform duration-200">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
          </h3>
          <div class="faq-answer hidden pb-6 text-charcoal-80 dark:text-charcoal-20 font-light">
            {{ faq.answer }}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqButtons = document.querySelectorAll('.faq-button');
    faqButtons.forEach(button => {
      button.addEventListener('click', function() {
        const faqItem = this.closest('.faq-item');
        const answer = faqItem.querySelector('.faq-answer');
        const isOpen = this.getAttribute('aria-expanded') === 'true';

        this.setAttribute('aria-expanded', !isOpen);
        faqItem.setAttribute('data-state', isOpen ? 'closed' : 'open');
        answer.classList.toggle('hidden');
        this.querySelector('svg').classList.toggle('rotate-180');
      });
    });
  });
</script>
{% endif %}

{% if related_workshops %}
<section class="py-24 lg:py-32 bg-offwhite dark:bg-black border-t border-charcoal-20 dark:border-charcoal-80 transition-colors">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="space-y-16">
      <h2 class="text-3xl font-medium text-charcoal dark:text-white transition-colors">Related workshops</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {% for workshop in related_workshops %}
        <article class="bg-white border border-charcoal-20 dark:bg-charcoal-80 rounded-2xl p-8 hover:shadow-md dark:hover:ring-1 dark:hover:ring-charcoal-20 transition-shadow duration-300">
          <div class="space-y-6">
            <div class="space-y-4">
              <div class="flex items-center gap-4 text-sm">
                <span class="bg-black dark:bg-white text-white dark:text-black px-3 py-1 rounded-full font-medium transition-colors">{{ workshop.category }}</span>
                <span class="text-charcoal-80 dark:text-charcoal-20 transition-colors">{{ workshop.format }}</span>
