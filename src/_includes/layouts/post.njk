---
layout: default
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "image": "{{ site.url }}{{ socialImage or featured_image or '/assets/headshot-1024x1024.png' }}",
  "datePublished": "{{ page.date | isoDate }}",
  "dateModified": "{{ (updated or page.date) | isoDate }}",
  "inLanguage": "en",
  "author": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "Gui Ferreira",
    "givenName": "Guilherme",
    "familyName": "Ferreira",
    "alternateName": "Guilherme Ferreira",
    "url": "{{ site.url }}/about/",
    "sameAs": [
      "https://twitter.com/gsferreira",
      "https://www.linkedin.com/in/gferreira",
      "https://github.com/gsferreira",
      "https://www.youtube.com/@gui.ferreira"
    ]
  },
  "publisher": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "Gui Ferreira",
    "url": "{{ site.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "{{ site.url }}/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ title | dump | safe }}
    }
  ]
}
</script>

<div class="max-w-3xl mx-auto px-4 pt-16">
  {#
    This nav already carried aria-label="Breadcrumb" while rendering a single
    back-link. It now renders the real trail, which is what the BreadcrumbList
    above describes. Structured data should not claim more than the page shows.
  #}
  <nav aria-label="Breadcrumb" class="mb-8">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <li><a href="/" class="hover:text-gray-700 dark:hover:text-gray-300">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/blog" class="hover:text-gray-700 dark:hover:text-gray-300">Blog</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-gray-700 dark:text-gray-300" aria-current="page">{{ title }}</li>
    </ol>
  </nav>

  <article class="prose prose-lg prose-headings:text-2xl prose-headings:font-medium prose-headings:mb-4 prose-p:text-[1.125rem] prose-p:leading-[1.8] max-w-none dark:prose-p:text-gray-300 dark:prose-li:text-gray-300 dark:prose-ul:text-gray-300 dark:prose-ol:text-gray-300 dark:prose-headings:text-white dark:prose-strong:text-white dark:prose-a:text-blue-400 dark:prose-a:hover:text-blue-300 dark:prose-invert">
    <header class="not-prose mb-16">
      <div class="flex items-center gap-6 mb-4">
        {% if category %}
        <span class="inline-flex items-center px-3 py-0.5 text-[13px] bg-black text-white rounded-full dark:bg-white dark:text-black">
          {{category}}
        </span>
        {% endif %}

        <div class="text-[15px] text-gray-500 dark:text-gray-400">
          <time datetime="{{ page.date | htmlDate }}">{{ page.date | readableDate }}</time> · <span>{{ content | readingTime }} min read</span>
          {% if updated %}
          · <span>Last updated <time datetime="{{ updated | htmlDate }}">{{ updated | readableDate }}</time></span>
          {% endif %}
        </div>
      </div>

      <h1 class="text-[2.5rem] font-medium leading-tight mb-4 text-gray-900 dark:text-white">{{ title }}</h1>

      {#
        Visible byline. The Article schema above already names the author, but
        models extract from the rendered text, and until now no post said who
        wrote it anywhere a reader or a crawler could see.
      #}
      <div class="flex items-center gap-3 mt-6">
        <img
          src="/assets/headshot-480w.webp"
          alt="Gui Ferreira"
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
          class="w-10 h-10 rounded-full object-cover"
        />
        <div class="text-[15px] leading-tight">
          <span class="text-gray-700 dark:text-gray-300">By
            <a href="/about" rel="author" class="font-medium text-gray-900 hover:underline dark:text-white">Gui Ferreira</a>
          </span>
          <span class="block text-[13px] text-gray-500 dark:text-gray-400">Microsoft MVP · Software engineer educator</span>
        </div>
      </div>
    </header>

    {{ content | safe }}
  </article>
</div>

{% include "components/related-posts.njk" %}

<div class="mt-32">
  {% include "components/newsletter.liquid" %}
</div> 